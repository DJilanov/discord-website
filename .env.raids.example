# All disabled by default. Never put OAuth secrets or real member IDs in git.
FOREVER_RAIDS_ENABLED=false
# pilot: approved accounts only; members: all currently verified Discord members.
FOREVER_RAIDS_ACCESS_MODE=pilot
FOREVER_RAIDS_PILOT_DISCORD_IDS=
COMMUNITY_DISCORD_CLIENT_ID=1554796912673169428
COMMUNITY_DISCORD_CLIENT_SECRET=
COMMUNITY_AUTH_SECRET=
DISCORD_GUILD_ID=1554316932948172940
# Website access accepts current members of either canonical community.
FOREVER_RAIDS_MEMBER_GUILD_IDS=1554316932948172940,1411533815356194968
# Needed for read-only server membership checks; not an OAuth client secret.
DISCORD_BOT_TOKEN=
KFC_DISCORD_INVITE_URL=https://discord.gg/WGv4APs9DY
AUTH_TRUST_HOST=true
FOREVER_RAIDS_DISCORD_ENABLED=false
FOREVER_RAIDS_DISCORD_CHANNEL_ID=
# Member beta uses a separate community channel; never repurpose the private test channel.
FOREVER_RAIDS_BETA_DISCORD_CHANNEL_ID=
FOREVER_RAIDS_BETA_DISCORD_CHANNEL_LABEL=Community event beta
# Enable only after the interaction endpoint and raid worker use this same database.
# Keep false for local-only posts delivered by a production Discord application.
FOREVER_RAIDS_NATIVE_ENABLED=false
# Optional approved private test channels, shown in the event browser.
# All must deny @everyone View Channel and explicitly allow only pilot members/bot.
# Entries can set guildId for a private KFC destination; organizer must belong there.
# FOREVER_RAIDS_DISCORD_DESTINATIONS=[{"channelId":"1556000000000000011","label":"KFC private raid test","guildId":"1556000000000000010"}]
FOREVER_RAIDS_DISCORD_DESTINATIONS=[]
# Discover text/announcement channels in these feedback servers, plus configured servers.
# Default: KFC. Organizer and bot must both be members with effective posting permissions.
# Community publication requires an explicit confirmation; no existing private post is moved.
FOREVER_RAIDS_DISCORD_FEEDBACK_GUILD_IDS=1411533815356194968
# Explicit website origin for Discord buttons; localhost only for private local tests.
FOREVER_RAIDS_PUBLIC_ORIGIN=http://127.0.0.1:19300
# OAuth redirect (register in Discord Developer Portal):
# https://www.wowforeverdiscord.online/api/community/auth/callback/discord
# http://localhost:19300/api/community/auth/callback/discord
# http://127.0.0.1:19300/api/community/auth/callback/discord
# Member secret must be >=32 characters and different from AUTH_SECRET.
