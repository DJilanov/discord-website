generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ForeverUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("editor")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ForeverSiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ForeverGuide {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  category        String
  coverImage      String    @default("/images/community.webp")
  author          String    @default("Forever Community Team")
  metaTitle       String?
  metaDescription String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([published, publishedAt])
}

model ForeverGuild {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  region            String
  realm             String
  faction           String
  ruleset           String
  language          String   @default("English")
  playstyle         String
  raidDays          String[]
  raidTime          String
  lootSystem        String
  recruitingClasses String[]
  description       String
  contactDiscord    String
  inviteUrl         String?
  websiteUrl        String?
  status            String   @default("pending")
  featured          Boolean  @default(false)
  submittedIpHash   String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([status, region, faction, ruleset])
}

model ForeverGroup {
  id              String   @id @default(cuid())
  title           String
  region          String
  realm           String
  faction         String
  activity        String
  description     String
  contactDiscord  String
  startsAt        DateTime
  expiresAt       DateTime
  status          String   @default("pending")
  submittedIpHash String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status, expiresAt])
}

model ForeverReport {
  id                 String   @id @default(cuid())
  publicId           String   @unique
  accessTokenHash    String
  reporterDiscord    String
  reporterCharacter  String
  character          String
  realm              String
  region             String
  guild              String?
  faction            String
  category           String
  incidentAt         DateTime
  description        String
  lootRules          String?
  status             String   @default("submitted")
  severity           Int      @default(1)
  assignedTo         String?
  decisionReason     String?
  internalNotes      String?
  firstReviewerId    String?
  submittedIpHash    String
  version            Int      @default(1)
  reviewedAt         DateTime?
  evidencePurgeAt    DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  evidence           ForeverEvidence[]
  appeals            ForeverAppeal[]
  alert              ForeverSafetyAlert?
  @@index([status, createdAt])
  @@index([character, realm, region])
}

model ForeverEvidence {
  id          String   @id @default(cuid())
  reportId    String
  appealId    String?
  storageKey  String   @unique
  name        String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())
  report      ForeverReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  appeal      ForeverAppeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)
}

model ForeverAppeal {
  id                String   @id @default(cuid())
  publicId          String   @unique
  reportId          String
  accessTokenHash   String
  appellantDiscord  String
  character         String
  explanation       String
  requestedOutcome String
  status            String   @default("submitted")
  decisionReason    String?
  reviewedBy        String?
  submittedIpHash   String
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  report            ForeverReport @relation(fields: [reportId], references: [id])
  evidence          ForeverEvidence[]
  @@index([status, createdAt])
}

model ForeverSafetyAlert {
  id             String   @id @default(cuid())
  reportId       String   @unique
  publicId       String   @unique
  character      String
  realm          String
  region         String
  guild          String?
  category       String
  severity       Int
  summary        String
  active         Boolean  @default(true)
  appealStatus   String   @default("none")
  lastReviewedAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  report         ForeverReport @relation(fields: [reportId], references: [id])
  @@index([active, expiresAt])
}

model ForeverAddonRelease {
  id            String   @id @default(cuid())
  version       String   @unique
  channel       String   @default("alpha")
  changelog     String
  storageKey    String
  sha256        String
  size          Int
  status        String   @default("draft")
  downloadCount Int      @default(0)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ForeverAnalyticsEvent {
  id          String   @id @default(cuid())
  event       String
  path        String
  sessionId   String?
  ipHash      String
  source      String
  referrerHost String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  country     String?
  device      String
  bot         Boolean @default(false)
  createdAt   DateTime @default(now())
  @@index([createdAt, event])
  @@index([source, createdAt])
  @@index([sessionId, createdAt])
}

model ForeverAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

model ForeverRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model ForeverWebhookJob {
  id          String   @id @default(cuid())
  kind        String
  entityId    String
  attempts    Int      @default(0)
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
}
