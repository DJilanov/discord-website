generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ForeverMember {
  id             String              @id @default(cuid())
  discordId      String              @unique
  displayName    String
  active         Boolean             @default(true)
  sessionVersion Int                 @default(1)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  characters     ForeverCharacter[]
  events         ForeverRaidEvent[]
  signups        ForeverRaidSignup[]
}

model ForeverRaidInteraction {
  id          String   @id
  actorId     String
  requestHash String
  response    Json
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model ForeverRaidNativeDraft {
  id              String    @id @default(uuid())
  actorId         String
  eventId         String
  guildId         String
  channelId       String
  sourceMessageId String
  revision        Int       @default(1)
  state           Json
  policyChecksum  String
  signupChecksum  String
  completedAt     DateTime? @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([eventId, actorId])
}

model ForeverRaidNativeWork {
  id            String    @id
  actorId       String
  input         Json
  tokenCipher   String?
  response      Json?
  status        String    @default("pending")
  attempts      Int       @default(0)
  leaseId       String?
  leaseUntil    DateTime? @db.Timestamptz(3)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([expiresAt])
}

model ForeverCharacter {
  id             String        @id @default(cuid())
  memberId       String
  member         ForeverMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name           String
  game           String        @default("forever")
  realm          String        @default("")
  className      String
  specialization String?
  region         String
  faction        String
  ruleset        String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([memberId, name, game, realm, region, faction, ruleset], map: "ForeverCharacter_identity_key")
}

model ForeverRaidCatalog {
  id         String             @id @default(cuid())
  raidName   String
  checksum   String             @unique
  bundle     Json
  warnings   String[]
  status     String             @default("staged")
  stagedBy   String
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?          @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  events     ForeverRaidEvent[]
}

model ForeverRaidEvent {
  id                  String                   @id @default(cuid())
  requestKey          String
  requestHash         String
  policyRevision      Int                      @default(0)
  organizerId         String
  organizer           ForeverMember            @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  audience            String[]
  title               String
  eventType           String                   @default("raid")
  game                String                   @default("forever")
  realm               String                   @default("")
  raidName            String
  region              String
  faction             String
  ruleset             String
  description         String
  startsAt            DateTime                 @db.Timestamptz(3)
  endsAt              DateTime                 @db.Timestamptz(3)
  signupClosesAt      DateTime                 @db.Timestamptz(3)
  reservesCloseAt     DateTime                 @db.Timestamptz(3)
  capacity            Int
  roleCaps            Json
  admission           String
  catalogId           String?
  catalog             ForeverRaidCatalog?      @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  reserveLimit        Int
  reserveLimits       Json?
  allowDuplicates     Boolean
  hardReserves        Int[]
  status              String                   @default("open")
  compositionRevision String                   @default("legacy")
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  signups             ForeverRaidSignup[]
  snapshot            ForeverRaidLootSnapshot?
  audits              ForeverRaidAudit[]
  discordPost         ForeverRaidDiscordPost?
  discordMirrors      ForeverRaidDiscordMirror[]

  @@unique([organizerId, requestKey])
  @@index([organizerId, startsAt])
}

model ForeverRaidDiscordPost {
  visibility        String           @default("private")
  label             String           @default("")
  confirmedAt       DateTime?        @db.Timestamptz(3)
  eventId           String           @id
  event             ForeverRaidEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guildId           String
  channelId         String
  origin            String
  messageId         String?
  repostNumber      Int              @default(0)
  previousMessageId String?
  previousRetiredAt DateTime?        @db.Timestamptz(3)
  lastRepostedAt    DateTime?        @db.Timestamptz(3)
  status            String           @default("pending")
  desiredVersion    Int
  deliveredVersion  Int              @default(0)
  attempts          Int              @default(0)
  lastError         String?
  nextAttemptAt     DateTime         @default(now()) @db.Timestamptz(3)
  startedAt         DateTime?        @db.Timestamptz(3)
  approvedAt        DateTime?        @db.Timestamptz(3)
  approvedBy        String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([channelId, messageId])
  @@index([status, nextAttemptAt])
}

model ForeverRaidDiscordMirror {
  id                String           @id @default(cuid())
  eventId           String
  event             ForeverRaidEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guildId           String
  channelId         String
  messageId         String
  origin            String
  confirmedAt       DateTime         @db.Timestamptz(3)
  status            String           @default("pending")
  desiredVersion    Int
  deliveredVersion  Int              @default(0)
  deliveredChecksum String?
  attempts          Int              @default(0)
  lastError         String?
  nextAttemptAt     DateTime         @default(now()) @db.Timestamptz(3)
  startedAt         DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([eventId, channelId])
  @@unique([channelId, messageId])
  @@index([status, nextAttemptAt])
}

model ForeverRaidSignup {
  id             String           @id @default(cuid())
  eventId        String
  event          ForeverRaidEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId       String
  member         ForeverMember    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  characterId    String
  character      Json
  role           String
  status         String
  partyIndex     Int?
  slotIndex      Int?
  reserves       Int[]
  policyChecksum String?
  acknowledgedAt DateTime?        @db.Timestamptz(3)
  importSource   Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([eventId, memberId])
  @@unique([eventId, partyIndex, slotIndex], map: "ForeverRaidSignup_event_party_slot_key")
}

model ForeverRaidLootSnapshot {
  id        String           @id @default(cuid())
  eventId   String           @unique
  event     ForeverRaidEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payload   Json
  checksum  String
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
}

model ForeverRaidAudit {
  id        String           @id @default(cuid())
  eventId   String
  event     ForeverRaidEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actorId   String
  action    String
  details   Json
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([eventId, createdAt])
}

model ForeverUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("editor")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ForeverSiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ForeverAuctionConfig {
  id        String   @id
  version   Int      @default(1)
  settings  Json
  updatedAt DateTime @updatedAt
}

model ForeverAuctionHealth {
  id        String   @id
  checkedAt DateTime
  status    String
}

model ForeverAuctionRun {
  id           String    @id
  jobKey       String    @unique
  marketKey    String
  sourceScanId String
  sourceAt     DateTime
  mode         String
  status       String
  reason       String
  title        String
  content      String
  channelId    String?
  threadId     String?
  messageId    String?
  observations Json      @default("[]")
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([marketKey, createdAt])
  @@index([marketKey, publishedAt])
}

model ForeverGuide {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  category        String
  coverImage      String    @default("/images/community.webp")
  author          String    @default("Forever Community Team")
  metaTitle       String?
  metaDescription String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

model ForeverGuild {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  region            String
  realm             String    @default("")
  faction           String
  ruleset           String    @default("")
  gameRuleset       String    @default("Unconfirmed")
  language          String    @default("English")
  playstyle         String
  raidDays          String[]
  raidTime          String
  lootSystem        String
  recruitingClasses String[]
  description       String
  contactDiscord    String
  inviteUrl         String?
  websiteUrl        String?
  status            String    @default("approved")
  featured          Boolean   @default(false)
  submittedIpHash   String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, region, faction, ruleset])
  @@index([status, region, faction, gameRuleset])
}

model ForeverGroup {
  id              String   @id @default(cuid())
  title           String
  region          String
  realm           String   @default("")
  gameRuleset     String   @default("Unconfirmed")
  faction         String
  activity        String
  description     String
  contactDiscord  String
  startsAt        DateTime
  expiresAt       DateTime
  status          String   @default("approved")
  submittedIpHash String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, expiresAt])
}

model ForeverListingDiscordJob {
  id                              String    @id @default(cuid())
  kind                            String
  entityId                        String
  forumId                         String
  title                           String
  content                         String
  attachment                      String?
  tagNames                        String[]
  consentAt                       DateTime  @default(now())
  status                          String    @default("queued")
  threadId                        String?   @unique
  verifiedTagId                   String?
  lastAuditId                     String?
  lastActorId                     String?
  lastError                       String?
  attempts                        Int       @default(0)
  nextAttemptAt                   DateTime  @default(now())
  checkedAt                       DateTime?
  reviewNotificationStatus        String    @default("queued")
  reviewNotificationMessageId     String?
  reviewNotificationAttempts      Int       @default(0)
  reviewNotificationNextAttemptAt DateTime  @default(now())
  reviewNotificationError         String?
  reviewNotifiedAt                DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  @@unique([kind, entityId])
  @@index([status, nextAttemptAt])
  @@index([reviewNotificationStatus, reviewNotificationNextAttemptAt])
}

model ForeverListingDiscordHealth {
  id        String   @id
  checkedAt DateTime
  status    String
}

model ForeverReport {
  id                String              @id @default(cuid())
  publicId          String              @unique
  accessTokenHash   String
  reporterDiscord   String
  reporterCharacter String
  character         String
  realm             String
  region            String
  guild             String?
  faction           String
  category          String
  incidentAt        DateTime
  description       String
  lootRules         String?
  status            String              @default("submitted")
  severity          Int                 @default(1)
  assignedTo        String?
  decisionReason    String?
  internalNotes     String?
  firstReviewerId   String?
  submittedIpHash   String
  version           Int                 @default(1)
  reviewedAt        DateTime?
  evidencePurgeAt   DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  evidence          ForeverEvidence[]
  appeals           ForeverAppeal[]
  alert             ForeverSafetyAlert?

  @@index([status, createdAt])
  @@index([character, realm, region])
}

model ForeverEvidence {
  id         String         @id @default(cuid())
  reportId   String
  appealId   String?
  storageKey String         @unique
  name       String
  mimeType   String
  size       Int
  createdAt  DateTime       @default(now())
  report     ForeverReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  appeal     ForeverAppeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)
}

model ForeverAppeal {
  id               String            @id @default(cuid())
  publicId         String            @unique
  reportId         String
  accessTokenHash  String
  appellantDiscord String
  character        String
  explanation      String
  requestedOutcome String
  status           String            @default("submitted")
  decisionReason   String?
  reviewedBy       String?
  submittedIpHash  String
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  report           ForeverReport     @relation(fields: [reportId], references: [id])
  evidence         ForeverEvidence[]

  @@index([status, createdAt])
}

model ForeverSafetyAlert {
  id             String        @id @default(cuid())
  reportId       String        @unique
  publicId       String        @unique
  character      String
  realm          String
  region         String
  guild          String?
  category       String
  severity       Int
  summary        String
  active         Boolean       @default(true)
  appealStatus   String        @default("none")
  lastReviewedAt DateTime      @default(now())
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  report         ForeverReport @relation(fields: [reportId], references: [id])

  @@index([active, expiresAt])
}

model ForeverAddonRelease {
  id            String    @id @default(cuid())
  version       String    @unique
  channel       String    @default("alpha")
  changelog     String
  storageKey    String
  sha256        String
  size          Int
  status        String    @default("draft")
  downloadCount Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ForeverAnalyticsEvent {
  id           String   @id @default(cuid())
  event        String
  path         String
  sessionId    String?
  ipHash       String
  source       String
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  country      String?
  device       String
  bot          Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt, event])
  @@index([source, createdAt])
  @@index([sessionId, createdAt])
}

model ForeverResearchFeedback {
  id         String    @id @default(cuid())
  path       String
  kind       String
  message    String?
  status     String    @default("new")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([path, createdAt])
}

model ForeverAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model ForeverRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model ForeverWebhookJob {
  id          String    @id @default(cuid())
  kind        String
  entityId    String
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
}

model ForeverDiscordBridge {
  slot           Int                         @default(1) @db.SmallInt
  id             String                      @id @default(uuid())
  name           String
  guildA         String
  channelA       String
  guildB         String
  channelB       String
  direction      String                      @default("two_way")
  state          String                      @default("draft")
  reviewRequired Boolean                     @default(true)
  version        Int                         @default(1)
  generation     Int                         @default(1)
  policyVersion  Int                         @default(1)
  activatedAt    DateTime?                   @db.Timestamptz
  validatedAt    DateTime?                   @db.Timestamptz
  fingerprint    String?
  approvalA      String?
  approvalB      String?
  noticeA        String?
  noticeB        String?
  moderatorIds   String[]                    @default([])
  pilotActorIds  String[]                    @default([])
  pilotUntil     DateTime?                   @db.Timestamptz
  blockedTerms   String[]                    @default([])
  reason         String?
  createdAt      DateTime                    @default(now()) @db.Timestamptz
  consents       ForeverBridgeConsent[]
  messages       ForeverBridgeMessage[]
  jobs           ForeverDiscordOutbox[]
  interactions   ForeverDiscordInteraction[]
  imports        ForeverBridgeImport[]
}

model ForeverBridgeConsent {
  bridgeId      String
  guildId       String
  actorId       String
  generation    Int
  policyVersion Int
  optedAt       DateTime             @default(now()) @db.Timestamptz
  withdrawnAt   DateTime?            @db.Timestamptz
  blocked       Boolean              @default(false)
  bridge        ForeverDiscordBridge @relation(fields: [bridgeId], references: [id], onDelete: Restrict)

  @@id([bridgeId, guildId, actorId])
}

model ForeverBridgeMessage {
  id               String                    @id @default(uuid())
  bridgeId         String
  guildId          String
  channelId        String
  messageId        String
  authorId         String
  generation       Int
  revision         Int                       @default(1)
  approvedRevision Int                       @default(0)
  state            String
  reason           String?
  parentId         String?
  sourceAt         DateTime                  @db.Timestamptz
  editedAt         DateTime?                 @db.Timestamptz
  expiresAt        DateTime                  @db.Timestamptz
  createdAt        DateTime                  @default(now()) @db.Timestamptz
  bridge           ForeverDiscordBridge      @relation(fields: [bridgeId], references: [id], onDelete: Restrict)
  parent           ForeverBridgeMessage?     @relation("BridgeReplies", fields: [parentId], references: [id], onDelete: Restrict)
  children         ForeverBridgeMessage[]    @relation("BridgeReplies")
  projection       ForeverBridgeProjection?
  jobs             ForeverDiscordOutbox[]
  historyBatchId   String?
  historyBatch     ForeverBridgeImport?      @relation(fields: [historyBatchId], references: [id], onDelete: Restrict)
  historyItems     ForeverBridgeImportItem[]

  @@unique([bridgeId, guildId, channelId, messageId])
  @@index([historyBatchId])
  @@index([bridgeId, authorId, state])
  @@index([parentId])
  @@index([expiresAt, state])
}

model ForeverBridgeProjection {
  id              String               @id @default(uuid())
  rootId          String               @unique
  guildId         String
  channelId       String
  messageId       String?              @unique
  candidateId     String?
  nonce           String               @unique
  state           String               @default("pending")
  appliedRevision Int                  @default(0)
  fingerprint     String?
  checkedAt       DateTime?            @db.Timestamptz
  removedAt       DateTime?            @db.Timestamptz
  root            ForeverBridgeMessage @relation(fields: [rootId], references: [id], onDelete: Restrict)

  @@index([state, checkedAt])
}

model ForeverBridgeImport {
  id          String                       @id
  bridgeId    String
  direction   String
  fromAt      DateTime                     @db.Timestamptz
  untilAt     DateTime                     @db.Timestamptz
  state       String                       @default("scanning")
  phase       String                       @default("scan")
  version     Int                          @default(1)
  cursorA     String?
  cursorB     String?
  doneA       Boolean                      @default(false)
  doneB       Boolean                      @default(false)
  limit       Int
  reason      String?
  fingerprint String
  dueAt       DateTime                     @default(now()) @db.Timestamptz
  createdAt   DateTime                     @default(now()) @db.Timestamptz
  bridge      ForeverDiscordBridge         @relation(fields: [bridgeId], references: [id], onDelete: Restrict)
  consents    ForeverBridgeImportConsent[]
  items       ForeverBridgeImportItem[]
  messages    ForeverBridgeMessage[]
}

model ForeverBridgeImportConsent {
  batchId       String
  guildId       String
  actorId       String
  policyVersion Int
  attestedBy    String
  optedAt       DateTime            @default(now()) @db.Timestamptz
  expiresAt     DateTime            @default(dbgenerated("now() + interval '30 days'")) @db.Timestamptz
  withdrawnAt   DateTime?           @db.Timestamptz
  batch         ForeverBridgeImport @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([batchId, guildId, actorId])
}

model ForeverBridgeImportItem {
  batchId     String
  guildId     String
  channelId   String
  messageId   String
  actorId     String
  sourceAt    DateTime              @db.Timestamptz
  fingerprint String
  state       String
  reason      String?
  rootId      String?
  batch       ForeverBridgeImport   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  root        ForeverBridgeMessage? @relation(fields: [rootId], references: [id], onDelete: SetNull)

  @@id([batchId, channelId, messageId])
  @@index([batchId, state, sourceAt, messageId])
}

model ForeverDiscordOutbox {
  id         String                @id @default(uuid())
  bridgeId   String
  rootId     String?
  operation  String
  revision   Int                   @default(0)
  dedupeKey  String                @unique
  state      String                @default("pending")
  leaseToken String?
  leaseUntil DateTime?             @db.Timestamptz
  startedAt  DateTime?             @db.Timestamptz
  attempts   Int                   @default(0)
  dueAt      DateTime              @default(now()) @db.Timestamptz
  error      String?
  createdAt  DateTime              @default(now()) @db.Timestamptz
  finishedAt DateTime?             @db.Timestamptz
  bridge     ForeverDiscordBridge  @relation(fields: [bridgeId], references: [id], onDelete: Restrict)
  root       ForeverBridgeMessage? @relation(fields: [rootId], references: [id], onDelete: Restrict)

  @@index([state, dueAt])
}

model ForeverDiscordInteraction {
  id            String               @id
  applicationId String
  guildId       String
  actorId       String
  bridgeId      String
  operation     String
  generation    Int
  policyVersion Int
  ack           Json
  state         String               @default("done")
  tokenCipher   String?
  challengeId   String?              @unique
  expiresAt     DateTime             @db.Timestamptz
  createdAt     DateTime             @default(now()) @db.Timestamptz
  error         String?
  bridge        ForeverDiscordBridge @relation(fields: [bridgeId], references: [id], onDelete: Restrict)

  @@index([state, expiresAt])
}

model ForeverBridgeRuntime {
  id          String    @id
  mode        String    @default("cleanup_only")
  version     Int       @default(1)
  heartbeatAt DateTime? @db.Timestamptz
  build       String?
  gateway     String    @default("offline")
  leaderId    String?
  gapAt       DateTime? @db.Timestamptz
  error       String?
}

model ForeverBridgeAdminRequest {
  id          String   @id
  actorId     String
  fingerprint String
  state       String
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}
