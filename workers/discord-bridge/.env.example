# Independent restricted worker environment. Never use the website's DB login.
BRIDGE_ENABLED=false
BRIDGE_DATABASE_URL=postgresql://forever_bridge_worker:replace@127.0.0.1:5432/postgres
BRIDGE_BOT_TOKEN=
# The same random 32-byte hex key is needed by the signed interaction endpoint.
BRIDGE_INTERACTION_KEY=
BRIDGE_FINGERPRINT_KEY=
BRIDGE_BUILD=local
